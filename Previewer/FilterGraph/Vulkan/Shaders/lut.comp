#version 450

// AOCE's 8x8 tiled 64^3 LUT lookup, adapted to linear RGBA16F images.
layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, rgba16f) uniform readonly image2D inTex;
layout (binding = 1) uniform sampler2D lutTex;
layout (binding = 2, rgba16f) uniform writeonly image2D outTex;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outTex);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec4 color = imageLoad(inTex, pixel);
    // A 64^3 LUT only defines the normalized domain. HDR values remain intact
    // instead of being silently clamped to the LUT edge.
    if (any(lessThan(color.rgb, vec3(0.0)))
        || any(greaterThan(color.rgb, vec3(1.0)))) {
        imageStore(outTex, pixel, color);
        return;
    }
    vec3 lookup = color.rgb;
    float blue = lookup.b * 63.0;
    vec2 tile0 = vec2(mod(floor(blue), 8.0), floor(floor(blue) / 8.0));
    vec2 tile1 = vec2(mod(ceil(blue), 8.0), floor(ceil(blue) / 8.0));
    vec2 local = (lookup.rg * 63.0 + 0.5) / 512.0;
    vec2 uv0 = tile0 / 8.0 + local;
    vec2 uv1 = tile1 / 8.0 + local;
    vec3 mapped = mix(texture(lutTex, uv0).rgb, texture(lutTex, uv1).rgb,
                      fract(blue));
    imageStore(outTex, pixel, vec4(mapped, color.a));
}
