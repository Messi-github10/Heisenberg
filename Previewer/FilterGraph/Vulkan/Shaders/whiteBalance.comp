#version 450

// Adapted from AOCE (MIT); see AOCE_LICENSE.txt.
layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, rgba16f) uniform readonly image2D inTex;
layout (binding = 1, rgba16f) uniform writeonly image2D outTex;

layout (std140, binding = 2) uniform WhiteBalanceParams {
    float temperature;
    float tint;
} params;

const vec3 WARM_FILTER = vec3(0.93, 0.54, 0.0);
const mat3 RGB_TO_YIQ = mat3(0.299, 0.587, 0.114,
                             0.596, -0.274, -0.322,
                             0.212, -0.523, 0.311);
const mat3 YIQ_TO_RGB = mat3(1.0, 0.956, 0.621,
                             1.0, -0.272, -0.647,
                             1.0, -1.105, 1.702);

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inTex);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec4 source = imageLoad(inTex, pixel);
    float temperatureScale = params.temperature < 5000.0 ? 0.0004 : 0.0006;
    float temperature = temperatureScale * (params.temperature - 5000.0);
    float tint = params.tint / 100.0;

    vec3 yiq = RGB_TO_YIQ * source.rgb;
    yiq.b = clamp(yiq.b + tint * 0.5226 * 0.1, -0.5226, 0.5226);
    vec3 rgb = YIQ_TO_RGB * yiq;
    vec3 processed = vec3(
        rgb.r < 0.5 ? 2.0 * rgb.r * WARM_FILTER.r
                    : 1.0 - 2.0 * (1.0 - rgb.r) * (1.0 - WARM_FILTER.r),
        rgb.g < 0.5 ? 2.0 * rgb.g * WARM_FILTER.g
                    : 1.0 - 2.0 * (1.0 - rgb.g) * (1.0 - WARM_FILTER.g),
        rgb.b < 0.5 ? 2.0 * rgb.b * WARM_FILTER.b
                    : 1.0 - 2.0 * (1.0 - rgb.b) * (1.0 - WARM_FILTER.b));
    imageStore(outTex, pixel,
               vec4(mix(rgb, processed, temperature), source.a));
}
