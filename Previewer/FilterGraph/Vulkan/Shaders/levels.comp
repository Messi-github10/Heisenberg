#version 450

// Adapted from AOCE (MIT); see AOCE_LICENSE.txt.
layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, rgba16f) uniform readonly image2D inTex;
layout (binding = 1, rgba16f) uniform writeonly image2D outTex;

layout (std140, binding = 2) uniform LevelsParams {
    float inputMinR;
    float inputMinG;
    float inputMinB;
    float gammaR;
    float gammaG;
    float gammaB;
    float inputMaxR;
    float inputMaxG;
    float inputMaxB;
    float outputMinR;
    float outputMinG;
    float outputMinB;
    float outputMaxR;
    float outputMaxG;
    float outputMaxB;
} params;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inTex);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec4 color = imageLoad(inTex, pixel);
    vec3 inputMin = vec3(params.inputMinR, params.inputMinG, params.inputMinB);
    vec3 gammaValue = max(vec3(params.gammaR, params.gammaG, params.gammaB),
                          vec3(0.0001));
    vec3 inputMax = vec3(params.inputMaxR, params.inputMaxG, params.inputMaxB);
    vec3 outputMin = vec3(params.outputMinR, params.outputMinG, params.outputMinB);
    vec3 outputMax = vec3(params.outputMaxR, params.outputMaxG, params.outputMaxB);
    vec3 denominator = max(inputMax - inputMin, vec3(0.0001));
    vec3 inputRange = clamp((color.rgb - inputMin) / denominator, 0.0, 1.0);
    vec3 adjusted = pow(inputRange, 1.0 / gammaValue);
    imageStore(outTex, pixel,
               vec4(mix(outputMin, outputMax, adjusted), color.a));
}
