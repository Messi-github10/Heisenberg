#version 450

// Adapted from AOCE (MIT); see AOCE_LICENSE.txt.
layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, rgba16f) uniform readonly image2D inTex;
layout (binding = 1, rgba16f) uniform writeonly image2D outTex;

layout (std140, binding = 2) uniform MonochromeParams {
    float intensity;
    float colorR;
    float colorG;
    float colorB;
} params;

const vec3 LUMINANCE_BT2020 = vec3(0.2627, 0.6780, 0.0593);

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inTex);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec4 source = imageLoad(inTex, pixel);
    float luminance = dot(source.rgb, LUMINANCE_BT2020);
    vec3 filterColor = vec3(params.colorR, params.colorG, params.colorB);
    vec3 toned = mix(2.0 * luminance * filterColor,
                     1.0 - 2.0 * (1.0 - luminance) * (1.0 - filterColor),
                     step(0.5, vec3(luminance)));
    imageStore(outTex, pixel,
               vec4(mix(source.rgb, toned, params.intensity), source.a));
}
