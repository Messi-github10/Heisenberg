cmake_minimum_required(VERSION 3.21)

file(READ "${SHADER_MANIFEST}" manifest)
string(JSON shader_count LENGTH "${manifest}" shaders)
set(shader_files)
if(shader_count GREATER 0)
    math(EXPR last_shader "${shader_count} - 1")
    foreach(index RANGE 0 ${last_shader})
        string(JSON shader_file GET "${manifest}" shaders ${index} spirv)
        if(NOT EXISTS "${SHADER_BINARY_DIR}/${shader_file}")
            message(FATAL_ERROR "Compiled filter shader is missing: ${shader_file}")
        endif()
        list(APPEND shader_files "${shader_file}")
    endforeach()
endif()

file(MAKE_DIRECTORY "${SHADER_DEPLOY_DIR}")
file(GLOB deployed_shaders "${SHADER_DEPLOY_DIR}/*.comp.spv")
foreach(shader IN LISTS deployed_shaders)
    get_filename_component(shader_file "${shader}" NAME)
    if(NOT shader_file IN_LIST shader_files)
        file(REMOVE "${shader}")
    endif()
endforeach()
foreach(shader_file IN LISTS shader_files)
    configure_file("${SHADER_BINARY_DIR}/${shader_file}"
        "${SHADER_DEPLOY_DIR}/${shader_file}" COPYONLY)
endforeach()
configure_file("${SHADER_MANIFEST}"
    "${SHADER_DEPLOY_DIR}/shader_manifest.json" COPYONLY)
