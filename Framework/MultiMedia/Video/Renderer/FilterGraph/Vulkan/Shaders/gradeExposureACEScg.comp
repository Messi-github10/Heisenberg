#version 450

// Linear ACEScg/AP1 RGB, straight alpha. Preserve HDR and negative components.
// The caller supplies ACEScg through its Color processor; no transfer here.
layout (local_size_x = 16, local_size_y = 16) in;
layout (binding = 0, rgba16f) uniform readonly image2D inTex;
layout (binding = 1, rgba16f) uniform writeonly image2D outTex;
layout (std140, binding = 2) uniform GradeExposureParams {
    float exposure;
} params;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outTex);
    if (any(greaterThanEqual(pixel, size))) return;
    vec4 color = imageLoad(inTex, pixel);
    color.rgb *= exp2(params.exposure);
    imageStore(outTex, pixel, color);
}
