#version 450

// Exposure in the linear BT.2020 RGBA16F working space.
// Values above 1.0 are intentional and must not be clamped here.
layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, rgba16f) uniform readonly image2D inTex;
layout (binding = 1, rgba16f) uniform image2D outTex;

layout (std140, binding = 2) uniform ExposureParams {
    float exposure;
} params;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inTex);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec4 color = imageLoad(inTex, pixel);
    color.rgb *= exp2(params.exposure);
    imageStore(outTex, pixel, color);
}
