#version 450

// Adapted from AOCE's colorInvert.comp for Heisenberg's RGBA16F working image.
layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, rgba16f) uniform readonly image2D inTex;
layout (binding = 1, rgba16f) uniform image2D outTex;

void main() {
    ivec2 uv = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inTex);
    if (uv.x >= size.x || uv.y >= size.y) {
        return;
    }
    vec4 color = imageLoad(inTex, uv);
    imageStore(outTex, uv, vec4(1.0 - color.rgb, color.a));
}
